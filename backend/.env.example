# Server
NODE_ENV=development
PORT=5000

# ── Database (Option A: single URL — takes priority) ──────────────────────────
DATABASE_URL=postgresql://localhost:5432/project_management

# ── Database (Option B: individual vars — used if DATABASE_URL is not set) ────
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=project_management
# DB_USER=postgres
# DB_PASSWORD=

# JWT
JWT_ACCESS_SECRET=your_access_secret_min_32_chars_here
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma-separated list of allowed frontend origins
# Local dev origins (localhost:3000 and localhost:5173) are always allowed in code.
# Add your production domain(s) here.
CORS_ORIGIN=https://ethara-nine-gold.vercel.app

# Rate Limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000
